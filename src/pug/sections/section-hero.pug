		img(src="/img/about/kushnarenko.webp" alt="Максим Кушнаренко").parallax.intro-img
	.section-hero__overlay
	.section-hero__body._container
		.section-hero__info
			.section-hero__content
				//*- Верхняя метка (Имя)
				.section-hero__top-tag.tl-1.intro-name
					span.section-hero__name-label Максим Кушнаренко
				//*- Заголовок H1
				.intro__title

.header._container 
	.header__content
		include @/pug/chunks/header-logo
		.header__top-menu(data-da="bp-1" data-da-position="0" data-da-resolution="960")   
			nav.top-menu
				ul.top-menu__list
					li.top-menu__item
						a(href="#about").top-menu__link.anchor-link
							span О нас
					li.top-menu__item
						a(href="#promo").top-menu__link.anchor-link
							span Видео
					li.top-menu__item
						a(href="#events").top-menu__link.anchor-link
							span Мероприятия
					li.top-menu__item
						a(href="#service").top-menu__link.anchor-link
							span Услуги
					li.top-menu__item
						a(href="#contacts").top-menu__link.anchor-link
							span Контакты
			//span.effect.filter
			//span.effect.text.hidden
		.header__contacts 
			a.top-menu__link(href="tel:+9106071900")
				span +7 910 607-19-00
				+iconfont('volume-control-phone', 'icon')
			.header__burger-button
				include @/pug/assets/burger-button
